{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local-llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini (local)",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "medium",
            "temperature": 1.0,
            "topP": 1.0
          }
        }
      }
    }
  },
  "model": "local-llama/inkling-2-mini",
  "small_model": "local-llama/inkling-2-mini"
}
